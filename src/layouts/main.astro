---
import "@/styles/global.css"
import { AppShell } from "@/components/app-shell"
import Meta from "@/components/meta.astro"
import { ThemeToggle } from "@/components/theme-toggle"
import { ClientRouter } from "astro:transitions"
import { PanelLeftIcon } from "lucide-react"

interface Props {
  title?: string
  description?: string
  image?: string
  noindex?: boolean
  ogType?: string
  articlePublishedTime?: Date
  articleModifiedTime?: Date
  jsonLdGraph?: Record<string, unknown>[]
  /** ヘッダー右のページラベル */
  headerLabel?: string
  /** コンテンツ領域の余白を外す（トップなど） */
  flush?: boolean
}

const {
  title,
  description,
  image,
  noindex,
  ogType,
  articlePublishedTime,
  articleModifiedTime,
  jsonLdGraph,
  headerLabel = "ホーム",
  flush = false,
} = Astro.props
---

<html lang="ja" transition:animate="none">
  <head>
    <Meta
      title={title}
      description={description}
      image={image}
      noindex={noindex}
      ogType={ogType}
      articlePublishedTime={articlePublishedTime}
      articleModifiedTime={articleModifiedTime}
      jsonLdGraph={jsonLdGraph}
    />
    <ClientRouter fallback="swap" />
    <script is:inline>
      (() => {
        const storageKey = "theme"
        const media = matchMedia("(prefers-color-scheme: dark)")

        const applyTheme = (root, stored = localStorage.getItem(storageKey)) => {
          const dark =
            stored === "dark" ||
            ((stored == null || stored === "system") && media.matches)
          root.classList.toggle("dark", dark)
          root.classList.toggle("light", !dark)
          root.style.colorScheme = dark ? "dark" : "light"
        }

        applyTheme(document.documentElement)
        media.addEventListener("change", () => {
          localStorage.setItem(storageKey, "system")
          applyTheme(document.documentElement, "system")
        })
        document.addEventListener("astro:before-swap", (event) => {
          applyTheme(event.newDocument.documentElement)
        })
        document.addEventListener("astro:after-swap", () => {
          applyTheme(document.documentElement)
        })
      })()
    </script>
  </head>
  <body>
    <div
      data-slot="sidebar-wrapper"
      class="group/sidebar-wrapper flex h-svh min-h-0 w-full overflow-hidden"
      style="--sidebar-width: 16rem; --sidebar-width-icon: 3rem;"
    >
      <div class="contents" transition:persist="app-shell">
        <AppShell client:load />
      </div>

      <main
        data-slot="sidebar-inset"
        class="relative grid h-full min-h-0 w-full flex-1 grid-rows-[auto_minmax(0,1fr)] overflow-hidden bg-background"
      >
        <header
          class="flex h-14 shrink-0 items-center gap-2 border-b px-4"
        >
          <button
            type="button"
            class="inline-flex size-7 items-center justify-center rounded-lg hover:bg-muted"
            aria-label="Toggle Sidebar"
            onclick="window.dispatchEvent(new CustomEvent('sidebar:toggle'))"
          >
            <PanelLeftIcon className="size-4" />
          </button>
          <div class="bg-border mr-2 h-4 w-px self-center"></div>
          <div class="min-w-0 flex-1">
            <slot name="header">
              <span class="text-sm text-muted-foreground">{headerLabel}</span>
            </slot>
          </div>
          <ThemeToggle client:load />
        </header>
        <div
          data-slot="page-scroll"
          class:list={["min-h-0 overflow-x-hidden overflow-y-auto", flush ? "p-0" : "p-4"]}
        >
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>

<style is:global>
  /* Let the sidebar gap participate in the outer flex layout */
  .contents > astro-island {
    display: contents;
  }
</style>
