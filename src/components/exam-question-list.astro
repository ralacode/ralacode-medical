---
import type { CollectionEntry } from "astro:content"

import { LinkCard } from "@/components/link-card"
import type { StudyTopicId } from "@/lib/exam-subjects"
import {
  compareQuestions,
  questionHeading,
  questionHref,
} from "@/lib/questions"

interface Props {
  questions: CollectionEntry<"questions">[]
  fromSubject?: boolean
  browseTopic?: StudyTopicId
}

const { questions, fromSubject = false, browseTopic } = Astro.props
const items = [...questions].sort(
  (left, right) =>
    right.data.year - left.data.year || compareQuestions(left.data, right.data)
)
---

<ul class="grid gap-3">
  {
    items.map((question) => {
      const item = question.data
      const href = questionHref(item.year, item.session, item.number, {
        from: fromSubject ? "subject" : undefined,
        topic: fromSubject ? browseTopic : undefined,
      })
      return (
        <li>
          <LinkCard
            href={href}
            label={`${questionHeading(item.exam, item.session, item.number)}${
              item.origin === "analog" ? " · 類似問題" : ""
            }`}
            title={item.stem}
          />
        </li>
      )
    })
  }
</ul>
