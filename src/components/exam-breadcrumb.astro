---
import { buttonVariants } from "@/components/ui/button"
import { subjectLabel, type ExamSubjectId } from "@/lib/exam-subjects"
import {
  examsHref,
  sessionLabel,
  yearHref,
  type ExamSession,
} from "@/lib/questions"

interface Props {
  year?: number
  session?: ExamSession
  number?: number
  subject?: ExamSubjectId
  class?: string
}

const { year, session, number, subject, class: className } = Astro.props
const atRoot = year == null && subject == null
const currentClass = "px-1 text-foreground"
const linkClass = buttonVariants({ variant: "default", size: "sm" })
---

<nav aria-label="パンくずリスト" class={className}>
  <ol class="flex min-w-0 items-center gap-2 overflow-hidden text-sm">
    <li>
      {
        atRoot ? (
          <span class={currentClass}>国家試験対策</span>
        ) : (
          <a class={linkClass} href={examsHref()}>
            国家試験対策
          </a>
        )
      }
    </li>
    {
      year ? (
        <>
          <li aria-hidden="true" class="text-muted-foreground">/</li>
          <li>
            {session ? (
              <a class={linkClass} href={yearHref(year)}>
                {year}年
              </a>
            ) : (
              <span class={currentClass}>{year}年</span>
            )}
          </li>
        </>
      ) : null
    }
    {
      session && number ? (
        <>
          <li aria-hidden="true" class="text-muted-foreground">/</li>
          <li class:list={[currentClass, "truncate"]}>
            {sessionLabel(session)} 問{number}
          </li>
        </>
      ) : null
    }
    {
      subject && !year ? (
        <>
          <li aria-hidden="true" class="text-muted-foreground">/</li>
          <li class:list={[currentClass, "truncate"]}>
            {subjectLabel(subject)}
          </li>
        </>
      ) : null
    }
  </ol>
</nav>
