---
import { ArticleBrowser } from "@/components/article-browser"
import Layout from "@/layouts/main.astro"
import { articleHref, articleDisplayTitle } from "@/lib/article-paths"
import { getPublishedArticles } from "@/lib/articles"

const articles = [...(await getPublishedArticles())].sort(
  (left, right) => right.data.pubDate.valueOf() - left.data.pubDate.valueOf()
)

const browserItems = articles.map((article) => ({
  href: articleHref(article.id),
  title: articleDisplayTitle(article.data.title),
  description: article.data.description,
  keywords: article.id,
}))
---

<Layout
  title="用語解説"
  description="診療放射線技師国家試験や現場で使う、CT・MRI・核医学まわりの用語を整理します。"
  headerLabel="用語解説"
>
  <div class="mx-auto grid max-w-2xl gap-8">
    <header class="grid gap-3">
      <h1 class="text-2xl font-semibold tracking-tight">用語解説</h1>
      <p class="text-sm leading-relaxed text-muted-foreground">
        試験でも現場でも使える粒度で、用語をまとめています。
      </p>
    </header>

    {
      browserItems.length === 0 ? (
        <p class="text-sm text-muted-foreground">公開中の記事はまだありません。</p>
      ) : (
        <ArticleBrowser client:load items={browserItems} />
      )
    }
  </div>
</Layout>
