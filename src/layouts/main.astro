---
import "@/styles/global.css"
import { AppShell } from "@/components/app-shell"
import { ClientRouter } from "astro:transitions"
import { PanelLeftIcon } from "lucide-react"
---

<html lang="ja" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Astro App</title>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <div
      data-slot="sidebar-wrapper"
      class="group/sidebar-wrapper flex min-h-svh w-full"
      style="--sidebar-width: 16rem; --sidebar-width-icon: 3rem;"
    >
      <div class="contents" transition:persist="app-shell">
        <AppShell client:load />
      </div>

      <main
        data-slot="sidebar-inset"
        class="relative grid h-svh w-full flex-1 grid-rows-[auto_1fr] bg-background"
      >
        <header
          class="grid h-14 shrink-0 grid-flow-col items-center justify-start gap-2 border-b px-4"
          transition:persist="app-header"
        >
          <button
            type="button"
            class="inline-flex size-7 items-center justify-center rounded-lg hover:bg-muted"
            aria-label="Toggle Sidebar"
            onclick="window.dispatchEvent(new CustomEvent('sidebar:toggle'))"
          >
            <PanelLeftIcon className="size-4" />
          </button>
          <div class="bg-border mr-2 h-4 w-px self-center"></div>
          <span class="text-sm text-muted-foreground">Dashboard</span>
        </header>
        <div class="overflow-auto p-4">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>

<style is:global>
  /* Let the sidebar gap participate in the outer flex layout */
  .contents > astro-island {
    display: contents;
  }
</style>
