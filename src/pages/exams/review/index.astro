---
import { ExamBreadcrumb } from "@/components/exam-breadcrumb"
import { ExamReview } from "@/components/exam-review"
import Layout from "@/layouts/main.astro"
import { getPublishedQuestions } from "@/lib/exam-content"
import {
  examReviewSeoDescription,
  examReviewSeoTitle,
  questionCategoryLinks,
  questionHref,
} from "@/lib/questions"

const questions = (await getPublishedQuestions()).map((question) => ({
  id: question.id,
  year: question.data.year,
  exam: question.data.exam,
  session: question.data.session,
  number: question.data.number,
  subject: question.data.subject,
  stem: question.data.stem,
  analog: question.data.origin === "analog",
  choiceTexts: question.data.choices.map((choice) => choice.text),
  categoryLinks: questionCategoryLinks(question.data),
  href: questionHref(
    question.data.year,
    question.data.session,
    question.data.number
  ),
}))
---

<Layout
  title={examReviewSeoTitle}
  description={examReviewSeoDescription}
  headerLabel="国家試験対策"
  robots="noindex, follow"
>
  <span slot="header" class="text-sm text-muted-foreground md:hidden">
    国家試験対策
  </span>
  <ExamBreadcrumb
    slot="header"
    className="hidden min-w-0 md:block"
    current="間違えた問題"
  />
  <div class="mx-auto grid max-w-2xl gap-8">
    <header class="grid gap-3">
      <ExamBreadcrumb className="md:hidden" current="間違えた問題" />
      <h1 class="text-2xl font-semibold tracking-tight">間違えた問題</h1>
      <p class="text-sm leading-relaxed text-muted-foreground">
        直近の1回目が不正解だった類似問題です。記録はこの端末のブラウザに保存されます。
      </p>
    </header>
    <ExamReview client:load questions={questions} />
  </div>
</Layout>
