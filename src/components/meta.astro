---
import { siteMeta } from "@/lib/constants"
import { withBase } from "@/lib/paths"

interface Props {
  title?: string
  description?: string
  /** `public/` 配下のパス（先頭スラッシュなし） */
  image?: string
  noindex?: boolean
  ogType?: string
  articlePublishedTime?: Date
  articleModifiedTime?: Date
  jsonLdGraph?: Record<string, unknown>[]
}

const {
  title: titleProp,
  description = siteMeta.siteDesc,
  image = siteMeta.siteImg,
  noindex = false,
  ogType = siteMeta.siteType,
  articlePublishedTime,
  articleModifiedTime,
  jsonLdGraph = [],
} = Astro.props

if (!Astro.site) {
  throw new Error("Set `site` in astro.config.mjs for SEO absolute URLs.")
}

const pageTitle = titleProp
  ? `${titleProp} | ${siteMeta.siteTitle}`
  : siteMeta.siteTitle

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href
const socialImageURL = new URL(withBase(image), Astro.site).href
const iconHref = withBase(siteMeta.siteIcon)
const siteURL = new URL(withBase(), Astro.site).href
const logoURL = new URL(withBase(siteMeta.siteIcon), Astro.site).href

const baseGraph = [
  {
    "@type": "WebSite",
    "@id": `${siteURL}#website`,
    url: siteURL,
    name: siteMeta.siteTitle,
    description: siteMeta.siteDesc,
    inLanguage: "ja",
    publisher: { "@id": `${siteURL}#organization` },
  },
  {
    "@type": "Organization",
    "@id": `${siteURL}#organization`,
    name: siteMeta.siteTitle,
    url: siteURL,
    logo: logoURL,
    sameAs: [siteMeta.authorUrl],
  },
]

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [...baseGraph, ...jsonLdGraph],
}

const jsonLdString = JSON.stringify(jsonLd).replace(/</g, "\\u003c")
const isArticle = ogType === "article"
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
{
  noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta name="robots" content="index, follow" />
  )
}

<title>{pageTitle}</title>
<meta name="description" content={description} />

<link rel="canonical" href={canonicalURL} />
<link rel="icon" type="image/png" href={iconHref} />
<link rel="apple-touch-icon" href={iconHref} />
<link rel="sitemap" href={withBase("sitemap-index.xml")} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={siteMeta.siteTitle}
  href={withBase("rss.xml")}
/>

<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={siteMeta.siteTitle} />
<meta property="og:type" content={ogType} />
<meta property="og:locale" content={siteMeta.siteLocale} />
<meta property="og:image" content={socialImageURL} />
{
  isArticle && articlePublishedTime ? (
    <meta
      property="article:published_time"
      content={articlePublishedTime.toISOString()}
    />
  ) : null
}
{
  isArticle && articleModifiedTime ? (
    <meta
      property="article:modified_time"
      content={articleModifiedTime.toISOString()}
    />
  ) : null
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageURL} />

<script type="application/ld+json" set:html={jsonLdString} />
