---
import { ExamBreadcrumb } from "@/components/exam-breadcrumb"
import { ExamSessionSummary } from "@/components/exam-session-summary"
import Layout from "@/layouts/main.astro"
import {
  examSessionSeoDescription,
  examSessionSeoTitle,
} from "@/lib/questions"
---

<Layout
  title={examSessionSeoTitle}
  description={examSessionSeoDescription}
  headerLabel="国家試験対策"
  robots="noindex, follow"
>
  <span slot="header" class="text-sm text-muted-foreground md:hidden">
    国家試験対策
  </span>
  <ExamBreadcrumb
    slot="header"
    className="hidden min-w-0 md:block"
    current="連続演習の結果"
  />
  <div class="mx-auto grid max-w-2xl gap-8">
    <header class="grid gap-3">
      <ExamBreadcrumb className="md:hidden" current="連続演習の結果" />
      <h1 class="text-2xl font-semibold tracking-tight">連続演習の結果</h1>
      <p class="text-sm leading-relaxed text-muted-foreground">
        記録はこの端末のブラウザに保存されます。
      </p>
    </header>
    <ExamSessionSummary client:load />
  </div>
</Layout>
