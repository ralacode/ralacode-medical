---
import { ADSENSE_CLIENT_ID, ADSENSE_PRODUCTION_HOST } from "@/lib/adsense"

const enabled = import.meta.env.PROD && Boolean(ADSENSE_CLIENT_ID)
---

{
  enabled ? (
    <>
      <meta name="google-adsense-account" content={ADSENSE_CLIENT_ID} />
      <script
        is:inline
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6190730534637732"
        crossorigin="anonymous"
      />
      <script
        is:inline
        define:vars={{ productionHost: ADSENSE_PRODUCTION_HOST }}
      >
        ;(function () {
          if (location.hostname !== productionHost) return
          if (window.__ralacodeAdsense) return
          window.__ralacodeAdsense = true

          document.addEventListener("astro:page-load", function () {
            var slots = document.querySelectorAll(
              "ins.adsbygoogle:not([data-adsbygoogle-status])"
            )
            for (var i = 0; i < slots.length; i++) {
              try {
                (window.adsbygoogle = window.adsbygoogle || []).push({})
              } catch (e) {}
            }
          })
        })()
      </script>
    </>
  ) : null
}

<script is:inline>
  // in-article（fluid）がシェルへ height:auto !important を付け、
  // overflow:hidden の内側スクロールを潰すのを戻す。
  ;(function () {
    if (window.__ralacodeShellHeightGuard) return
    window.__ralacodeShellHeightGuard = true

    var slots = ["sidebar-wrapper", "sidebar-inset"]
    var seen = new WeakSet()

    function revert(el) {
      if (!el || !el.style) return
      if (el.style.getPropertyValue("height") === "auto") {
        el.style.removeProperty("height")
      }
    }

    function guard(el) {
      if (!el || seen.has(el)) return
      seen.add(el)
      revert(el)
      new MutationObserver(function () {
        revert(el)
      }).observe(el, { attributes: true, attributeFilter: ["style"] })
    }

    function scan() {
      for (var i = 0; i < slots.length; i++) {
        var nodes = document.querySelectorAll('[data-slot="' + slots[i] + '"]')
        for (var j = 0; j < nodes.length; j++) guard(nodes[j])
      }
    }

    document.addEventListener("astro:page-load", scan)
    document.addEventListener("astro:after-swap", scan)
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", scan)
    } else {
      scan()
    }
  })()
</script>
