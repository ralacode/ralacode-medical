---
import type { CollectionEntry } from "astro:content"

import ExamBreadcrumb from "@/components/exam-breadcrumb.astro"
import { NextQuestionNav } from "@/components/next-question-nav"
import { QuestionQuiz } from "@/components/question-quiz"
import { buttonVariants } from "@/components/ui/button"
import Layout from "@/layouts/main.astro"
import { getArticlesByTermIds } from "@/lib/articles"
import { getPublishedQuestions } from "@/lib/exam-content"
import {
  officialExamBookletPdfLink,
  officialExamPdfLink,
} from "@/lib/exam-pdfs"
import { renderMarkdown } from "@/lib/markdown"
import { subjectLabel } from "@/lib/exam-subjects"
import {
  answerLabel,
  compareQuestions,
  questionHeading,
  questionNavTarget,
  sessionLabel,
  singleAnswer,
  subjectHref,
  yearHref,
  type QuestionNavTarget,
} from "@/lib/questions"

interface Props {
  question: CollectionEntry<"questions">
  examNext?: QuestionNavTarget
  subjectNext?: QuestionNavTarget
}

export async function getStaticPaths() {
  const questions = [...(await getPublishedQuestions())].sort((left, right) =>
    compareQuestions(left.data, right.data)
  )

  return questions.map((question, index) => {
    const inSubject = questions.filter(
      (entry) => entry.data.subject === question.data.subject
    )
    const subjectIndex = inSubject.findIndex(
      (entry) =>
        entry.data.year === question.data.year &&
        entry.data.session === question.data.session &&
        entry.data.number === question.data.number
    )
    const examNextEntry = questions[index + 1]
    const subjectNextEntry = inSubject[subjectIndex + 1]

    return {
      params: {
        year: String(question.data.year),
        session: question.data.session,
        number: String(question.data.number),
      },
      props: {
        question,
        examNext: examNextEntry
          ? questionNavTarget(examNextEntry.data)
          : undefined,
        subjectNext: subjectNextEntry
          ? questionNavTarget(subjectNextEntry.data, { from: "subject" })
          : undefined,
      },
    }
  })
}

const { question, examNext, subjectNext } = Astro.props
const { year, exam, session, number, stem, choices, origin, subject, sourceExplanation, mapsTo, terms } =
  question.data
const termLinks = await getArticlesByTermIds(terms)
const answer = singleAnswer(question.data.answer)
const heading = questionHeading(exam, session, number)
const title = `${heading}（類似問題）`
const description = `第${exam}回 ${sessionLabel(session)} 問${number}の出題意図に沿った類似問題です。公式問題の転載ではありません。`
const quizChoices = choices.map((choice) => ({
  text: choice.text,
  explanationHtml: choice.explanation.trim()
    ? renderMarkdown(choice.explanation)
    : "",
}))
const sourceExplanationHtml = sourceExplanation?.trim()
  ? renderMarkdown(sourceExplanation)
  : undefined
const sourceExplanationTitle = `${mapsTo.year}年 ${sessionLabel(mapsTo.session)} 問${mapsTo.number}の解説`
const sourceAnswerLabel = answerLabel(mapsTo.answer)
const sourcePdf = officialExamPdfLink(
  mapsTo.year,
  mapsTo.session,
  mapsTo.number
)
const sourceBookletPdf = officialExamBookletPdfLink(
  mapsTo.year,
  mapsTo.session,
  mapsTo.number
)
---

<Layout title={title} description={description} headerLabel="国家試験対策">
  <span slot="header" class="text-sm text-muted-foreground md:hidden">
    国家試験対策
  </span>
  <ExamBreadcrumb
    slot="header"
    class="hidden min-w-0 md:block"
    year={year}
    session={session}
    number={number}
  />
  <article class="mx-auto grid max-w-2xl gap-6">
    <header class="grid gap-3">
      <ExamBreadcrumb
        class="md:hidden"
        year={year}
        session={session}
        number={number}
      />
      <p class="text-sm text-muted-foreground">
        {year}年 · {heading}
        {origin === "analog" ? " · 類似問題" : ""}
      </p>
      <h1
        id="question-stem"
        class="text-xl leading-snug font-semibold tracking-tight"
      >
        {stem}
      </h1>
      <a
        class:list={[buttonVariants({ variant: "default" }), "min-h-11 w-fit"]}
        href={subjectHref(subject)}
      >
        {subjectLabel(subject)}
      </a>
      <p class="text-xs text-muted-foreground">
        公式の問題文・選択肢は掲載していません。出題の要点に沿って作り直したオリジナル問題です。
      </p>
      {
        termLinks.length > 0 ? (
          <section class="grid gap-2" aria-label="関連する用語">
            <h2 class="text-sm font-medium">関連する用語</h2>
            <ul class="flex flex-wrap gap-2">
              {termLinks.map((term) => (
                <li>
                  <a
                    class:list={[
                      buttonVariants({ variant: "outline" }),
                      "min-h-9",
                    ]}
                    href={term.href}
                  >
                    {term.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ) : null
      }
    </header>
    <QuestionQuiz
      client:load
      labelledBy="question-stem"
      choices={quizChoices}
      answer={answer}
      shuffleChoices={question.data.shuffleChoices}
      sourceExplanationHtml={sourceExplanationHtml}
      sourceExplanationTitle={sourceExplanationTitle}
      sourceAnswerLabel={sourceAnswerLabel}
      sourcePdfHref={sourcePdf?.href}
      sourcePdfPage={sourcePdf?.page}
      sourceBookletPdfHref={sourceBookletPdf?.href}
      sourceBookletPdfPage={sourceBookletPdf?.page}
    />
    <NextQuestionNav
      client:load
      examNext={examNext}
      subjectNext={subjectNext}
      examBackHref={yearHref(year)}
      subjectBackHref={subjectHref(subject)}
      subjectLabel={subjectLabel(subject)}
      year={year}
    />
  </article>
</Layout>
