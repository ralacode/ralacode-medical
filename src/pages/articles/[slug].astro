---
import type { CollectionEntry } from "astro:content"
import { render } from "astro:content"
import { ArrowLeftIcon } from "lucide-react"

import { LinkCard } from "@/components/link-card"
import { buttonVariants } from "@/components/ui/button"
import ExamCtaCard from "@/components/exam-cta-card.astro"
import InArticleAd from "@/components/in-article-ad.astro"
import KeyPoint from "@/components/key-point.astro"
import Layout from "@/layouts/main.astro"
import { articlesHref } from "@/lib/article-paths"
import { buildArticleJsonLd } from "@/lib/article-seo"
import { getPublishedArticles } from "@/lib/articles"
import { getQuestionsByTermId } from "@/lib/exam-content"
import { renderMarkdown } from "@/lib/markdown"
import { cn } from "@/lib/utils"

interface Props {
  article: CollectionEntry<"articles">
}

export async function getStaticPaths() {
  const articles = await getPublishedArticles()

  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }))
}

const { article } = Astro.props
const { title, description, pubDate, updatedDate, faq } = article.data
const { Content } = await render(article)
const relatedQuestions = await getQuestionsByTermId(article.id)
const modifiedDate = updatedDate ?? pubDate

if (!Astro.site) {
  throw new Error("Set `site` in astro.config.mjs.")
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href
const jsonLdGraph = buildArticleJsonLd({
  site: Astro.site,
  canonicalURL,
  title,
  description,
  pubDate,
  updatedDate,
  faq,
})

const formattedDate = pubDate.toLocaleDateString("ja-JP", {
  year: "numeric",
  month: "long",
  day: "numeric",
})
const formattedUpdated =
  updatedDate &&
  updatedDate.toLocaleDateString("ja-JP", {
    year: "numeric",
    month: "long",
    day: "numeric",
  })
---

<Layout
  title={title}
  description={description}
  ogType="article"
  articlePublishedTime={pubDate}
  articleModifiedTime={modifiedDate}
  jsonLdGraph={jsonLdGraph}
  headerLabel="用語解説"
>
  <article class="term-article mx-auto grid max-w-2xl gap-6">
    <header class="grid gap-3">
      <a
        class={cn(buttonVariants({ variant: "default" }), "w-fit px-2")}
        href={articlesHref()}
      >
        <ArrowLeftIcon data-icon="inline-start" />
        用語解説一覧
      </a>
      <p class="text-sm text-muted-foreground">
        公開 {formattedDate}
        {formattedUpdated ? ` · 更新 ${formattedUpdated}` : ""}
      </p>
      <h1 class="text-2xl font-semibold tracking-tight">{title}</h1>
      <p class="text-sm leading-relaxed text-muted-foreground">{description}</p>
    </header>
    <div data-article-body>
      <div class="article-md" data-article-md>
        <Content components={{ KeyPoint }} />
      </div>
      <div class="my-8 grid gap-4" data-article-mid-slot>
        <ExamCtaCard />
        <InArticleAd />
      </div>
    </div>
    <script is:inline data-astro-rerun>
      ;(function () {
        var body = document.querySelector("[data-article-body]")
        if (!body) return
        var md = body.querySelector("[data-article-md]")
        var slot = body.querySelector("[data-article-mid-slot]")
        if (!md || !slot) return
        var heading = md.querySelector("h2")
        if (!heading) return

        var rest = document.createElement("div")
        rest.className = md.className
        var node = heading
        while (node) {
          var next = node.nextSibling
          rest.appendChild(node)
          node = next
        }
        md.after(slot)
        slot.after(rest)
      })()
    </script>

    {
      faq.length > 0 ? (
        <section class="grid gap-3" aria-labelledby="article-faq">
          <h2 id="article-faq" class="text-xl font-semibold tracking-tight">
            よくある質問
          </h2>
          {faq.map((item) => (
            <div class="grid gap-2">
              <h3 class="text-lg font-medium">{item.question}</h3>
              <div
                class="text-base leading-relaxed text-muted-foreground"
                set:html={renderMarkdown(item.answer)}
              />
            </div>
          ))}
        </section>
      ) : null
    }

    {
      relatedQuestions.length > 0 ? (
        <section class="grid gap-3" aria-labelledby="related-questions">
          <h2
            id="related-questions"
            class="text-xl font-semibold tracking-tight"
          >
            関連する問題
          </h2>
          <ul class="grid gap-3">
            {relatedQuestions.map((question) => (
              <li>
                <LinkCard
                  href={question.href}
                  label={`${question.heading} · 類似問題`}
                  title={question.stem}
                />
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }
  </article>
</Layout>
