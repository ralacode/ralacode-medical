---
import { LinkCard } from "@/components/link-card"
import Layout from "@/layouts/main.astro"
import { getCatalogQuestions } from "@/lib/exam-content"
import { examYearData } from "@/lib/exam-data"
import {
  canRevealExamYear,
  catalogExamYears,
  isExamYearPreparing,
} from "@/lib/exam-visibility"
import { subjectLabel, studyTopicLabel } from "@/lib/exam-subjects"
import {
  browseCategoryHref,
  examBrowseSeoDescription,
  examBrowseSeoTitle,
  groupQuestions,
  groupQuestionsByStudyTopic,
  groupQuestionsBySubject,
  reviewHref,
  sessionLabel,
  statsHref,
  yearHref,
} from "@/lib/questions"

const catalog = await getCatalogQuestions()
const listedQuestions = catalog
  .filter((question) => canRevealExamYear(question.data.year))
  .map((question) => question.data)
const catalogYears = catalogExamYears(catalog.map((question) => question.data.year))
const listedGroups = groupQuestions(listedQuestions)
const listedByYear = new Map(listedGroups.map((group) => [group.year, group]))
const yearCards: {
  year: number
  exam: number
  preparing: boolean
  count: number
  sessionCounts: string
}[] = []
for (const year of catalogYears) {
  const preparing = isExamYearPreparing(year)
  const group = listedByYear.get(year)
  const exam = group?.exam ?? examYearData(year)?.exam
  if (exam == null) continue
  if (preparing) {
    yearCards.push({ year, exam, preparing, count: 0, sessionCounts: "" })
    continue
  }
  if (!group) continue
  const count = group.sessions.reduce(
    (sum, session) => sum + session.items.length,
    0
  )
  const sessionCounts = group.sessions
    .map(
      (session) => ` · ${sessionLabel(session.session)} ${session.items.length}問`
    )
    .join("")
  yearCards.push({ year, exam, preparing, count, sessionCounts })
}
const subjects = groupQuestionsBySubject(listedQuestions)
const studyTopics = groupQuestionsByStudyTopic(listedQuestions)
---

<Layout
  title={examBrowseSeoTitle}
  description={examBrowseSeoDescription}
  headerLabel="国家試験対策"
>
  <div class="mx-auto grid max-w-2xl gap-8">
    <header class="grid gap-3">
      <h1 class="text-2xl font-semibold tracking-tight">{examBrowseSeoTitle}</h1>
      <p class="text-sm leading-relaxed text-muted-foreground">
        年次または科目から探せます。
      </p>
    </header>

    <div class="grid gap-3">
      <LinkCard href={reviewHref()} title="苦手問題を見る" />
      <LinkCard href={statsHref()} title="科目別の正答率を見る" />
    </div>

    {
      yearCards.length === 0 ? (
        <p class="text-sm text-muted-foreground">公開中の問題はまだありません。</p>
      ) : (
        <div class="browse grid gap-6">
          <div
            class="grid grid-cols-2 gap-1 rounded-xl bg-muted p-1"
            role="radiogroup"
            aria-label="類似問題の探し方"
          >
            <label class="flex min-h-11 cursor-pointer items-center justify-center rounded-lg text-sm font-medium text-muted-foreground has-checked:bg-background has-checked:text-foreground has-checked:shadow-sm">
              <input
                class="sr-only"
                type="radio"
                name="exam-browse"
                value="years"
                checked
              />
              年次から探す
            </label>
            <label class="flex min-h-11 cursor-pointer items-center justify-center rounded-lg text-sm font-medium text-muted-foreground has-checked:bg-background has-checked:text-foreground has-checked:shadow-sm">
              <input
                class="subject-tab sr-only"
                type="radio"
                name="exam-browse"
                value="subjects"
              />
              科目から探す
            </label>
          </div>

          <section class="browse-years grid gap-3" aria-label="年次">
            <ul class="grid gap-3">
              {yearCards.map((card) => (
                <li>
                  <LinkCard
                    href={yearHref(card.year)}
                    title={`${card.year}年 第${card.exam}回`}
                    description={
                      card.preparing
                        ? "準備中"
                        : `類似問題 ${card.count}問${card.sessionCounts}`
                    }
                  />
                </li>
              ))}
            </ul>
          </section>

          <section class="browse-subjects grid gap-6" aria-label="科目">
            <div class="grid gap-3">
              <h2 class="text-sm font-medium text-muted-foreground">試験科目</h2>
              <ul class="grid gap-3">
                {subjects.map((group) => (
                  <li>
                    <LinkCard
                      href={browseCategoryHref(group.subject)}
                      title={subjectLabel(group.subject)}
                      description={`類似問題 ${group.items.length}問`}
                    />
                  </li>
                ))}
              </ul>
            </div>
            {
              studyTopics.length > 0 ? (
                <div class="grid gap-3">
                  <h2 class="text-sm font-medium text-muted-foreground">
                    理工学・放射線科学（細分）
                  </h2>
                  <ul class="grid gap-3">
                    {studyTopics.map((group) => (
                      <li>
                        <LinkCard
                          href={browseCategoryHref(group.topic)}
                          title={studyTopicLabel(group.topic)}
                          description={`類似問題 ${group.items.length}問`}
                        />
                      </li>
                    ))}
                  </ul>
                </div>
              ) : null
            }
          </section>
        </div>
      )
    }
  </div>
</Layout>

<style>
  .browse-subjects {
    display: none;
  }

  .browse:has(.subject-tab:checked) .browse-years {
    display: none;
  }

  .browse:has(.subject-tab:checked) .browse-subjects {
    display: grid;
  }
</style>
