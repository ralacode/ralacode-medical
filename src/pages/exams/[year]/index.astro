---
import type { CollectionEntry } from "astro:content"

import ExamBreadcrumb from "@/components/exam-breadcrumb.astro"
import { ExamQuestionBrowser } from "@/components/exam-question-browser"
import Layout from "@/layouts/main.astro"
import { getPublishedQuestions } from "@/lib/exam-content"
import { subjectLabel } from "@/lib/exam-subjects"
import {
  groupQuestions,
  questionHeading,
  questionHref,
  sessionLabel,
  subjectHref,
} from "@/lib/questions"

interface Props {
  year: number
  questions: CollectionEntry<"questions">[]
}

export async function getStaticPaths() {
  const questions = await getPublishedQuestions()
  const years = [...new Set(questions.map((question) => question.data.year))]

  return years.map((year) => ({
    params: { year: String(year) },
    props: {
      year,
      questions: questions.filter((question) => question.data.year === year),
    },
  }))
}

const { year, questions } = Astro.props
const [group] = groupQuestions(questions.map((question) => question.data))
const exam = group?.exam
const title = exam ? `${year}年 第${exam}回` : `${year}年`
const description = exam
  ? `第${exam}回診療放射線技師国家試験の出題意図に沿った類似問題です。公式問題の転載ではありません。`
  : `${year}年の類似問題です。`
---

<Layout title={title} description={description} headerLabel="国家試験対策">
  <span slot="header" class="text-sm text-muted-foreground md:hidden">
    国家試験対策
  </span>
  <ExamBreadcrumb slot="header" class="hidden min-w-0 md:block" year={year} />
  <div class="mx-auto grid max-w-2xl gap-8">
    <header class="grid gap-3">
      <ExamBreadcrumb class="md:hidden" year={year} />
      <h1 class="text-2xl font-semibold tracking-tight">{title}</h1>
      <p class="text-sm leading-relaxed text-muted-foreground">
        公式の問題文・選択肢は掲載していません。類似問題を選んで演習できます。
      </p>
    </header>

    {
      group ? (
        <ExamQuestionBrowser
          client:load
          sections={group.sessions.map((session) => ({
            title: sessionLabel(session.session),
            items: questions
              .filter((question) => question.data.session === session.session)
              .sort((left, right) => left.data.number - right.data.number)
              .map((question) => {
                const item = question.data
                return {
                  href: questionHref(item.year, item.session, item.number),
                  heading: questionHeading(item.exam, item.session, item.number),
                  stem: item.stem,
                  analog: item.origin === "analog",
                  subjectHref: subjectHref(item.subject),
                  subjectLabel: subjectLabel(item.subject),
                }
              }),
          }))}
        />
      ) : (
        <p class="text-sm text-muted-foreground">この年の問題はまだありません。</p>
      )
    }
  </div>
</Layout>
